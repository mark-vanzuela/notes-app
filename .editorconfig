root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# C# / .NET
[*.{cs,csx}]
indent_size = 4

[*.{csproj,props,targets,sln}]
indent_size = 2

# Markdown — keep trailing whitespace (hard line breaks)
[*.md]
trim_trailing_whitespace = false

# YAML
[*.{yml,yaml}]
indent_size = 2
