# Copy to `.env` and adjust. `.env` is git-ignored — never commit real secrets.

# ── Postgres (local Docker Compose) ───────────────────────────────────
POSTGRES_USER=notes
POSTGRES_PASSWORD=notes_dev_password
POSTGRES_DB=notesdb
POSTGRES_PORT=5432

# ── API ───────────────────────────────────────────────────────────────
# Local dev points at the Compose postgres service ("db").
# In prod (Azure), this is set to the Neon connection string via secrets.
ConnectionStrings__Default=Host=db;Port=5432;Database=notesdb;Username=notes;Password=notes_dev_password
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080

# ── Frontend ──────────────────────────────────────────────────────────
# Base URL the React app uses to reach the API.
VITE_API_BASE_URL=http://localhost:8080
WEB_PORT=5173
