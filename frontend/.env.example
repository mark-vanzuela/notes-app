# Copy to .env and fill in. Vite only exposes vars prefixed with VITE_ to the app,
# and it BAKES them in at build time (they are not secret — they ship in the bundle).

# Base URL of the Notes API.
VITE_API_BASE_URL=http://localhost:8080/api

# Google OAuth Web client id (xxxx.apps.googleusercontent.com). Must MATCH the value
# configured on the API (Authentication:Google:ClientId) — the API validates that the
# Google token's audience equals this id. Real sign-in does not work until this is set.
VITE_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID.apps.googleusercontent.com
